 }
 
 uint64
@@ -107,3 +109,31 @@ sys_uptime(void)
   release(&tickslock);
   return xticks;
 }
+
+void
+sys_knockknock(void)
+{
+  int p=myproc()->pid;
+  printf("I am %d, Who's there?\n",p);
+  return;
+}
+
+void
+sys_getProcessStates(void)
+{
+  static char *states[] = {
+    [UNUSED]    "unused",
+    [USED]      "used",
+    [SLEEPING]  "sleep ",
+    [RUNNABLE]  "runble",
+    [RUNNING]   "run   ",
+    [ZOMBIE]    "zombie"
+  };
+  struct proc *p;
+  for(p = myproc(); p < &myproc()[NPROC]; p++) {
+    if(p->state != UNUSED) {
+      printf("Process %d was found in %s state\n",p->pid,states[p->state]);
+    }
+  }
+  return;
+}
