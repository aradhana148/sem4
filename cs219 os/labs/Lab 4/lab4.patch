diff --git a/user/p4.c b/user/p4.c
new file mode 100644
index 0000000..2751fca
--- /dev/null
+++ b/user/p4.c
@@ -0,0 +1,31 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+int main() {
+    int i, pid;
+
+    printf("Parent pid: %d\n", getpid());
+
+    for (i = 0; i < 3; i++) {
+        pid = fork();
+        if (pid == 0) {
+            pause(10);
+            exit(0);
+        }
+    }
+
+    pause(5);
+    getProcessStates();
+    pause(30);
+
+    printf("\n=== Process states after exiting ===\n");
+    getProcessStates();
+
+    for (i = 0; i < 3; i++) wait(0);
+
+    printf("\n=== Process states reaping ===\n");
+    getProcessStates();
+
+    exit(0);
+}
